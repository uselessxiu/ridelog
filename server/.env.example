# RIDELOG Server Environment Configuration
# Copy this file to .env and fill in your private API keys.
# NEVER commit .env to version control or expose these keys to frontend code.

# Server Port (default 8080)
PORT=8080

# Google Gemini API Key for AI Motorcycle Identification
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Clerk Authentication (Clerk Dashboard > API Keys)
# Keep Secret Key server-side only. Frontend uses Publishable Key only.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://evolving-burro-2452.clerk.accounts.dev/.well-known/jwks.json

# Firebase Firestore Server Configuration
# For privileged backend writes with Firebase Admin SDK:
# In Production (e.g. Render), configure the service account JSON as an environment variable:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=ridelog-796ba

# Local development fallback (path to serviceAccountKey.json):
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

